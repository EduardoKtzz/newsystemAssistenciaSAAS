# Copie para .env.local e preencha. O .env.local NÃO vai para o git.

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave pública (anon / publishable). Pode aparecer no navegador: quem
# protege os dados por trás dela é a RLS do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service_role). IGNORA A RLS POR COMPLETO.
# Só o servidor usa, só o portal do cliente precisa dela, e ela nunca pode
# ganhar o prefixo NEXT_PUBLIC_ — isso a mandaria para dentro do JavaScript
# que qualquer visitante baixa, e entregaria o banco inteiro.
SUPABASE_SERVICE_ROLE_KEY=

# Assina o cookie que lembra a confirmação do cliente no portal.
# Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_SECRET=

# Endereço público do sistema. Entra no link impresso no comprovante e nas
# mensagens de WhatsApp, então em produção precisa ser o domínio real.
NEXT_PUBLIC_URL_BASE=http://localhost:3000
